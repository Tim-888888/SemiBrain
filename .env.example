# Configuration names only. Use separate private files for each service.
# Keep real values outside the repository and inject only the keys each service needs.
SEMIBRAIN_ENV=development
SEMIBRAIN_DEMO_MODE=false
SEMIBRAIN_STAGE=knowledge-platform
SEMIBRAIN_SERVICE=
SEMIBRAIN_MONGO_URI=
SEMIBRAIN_REDIS_URL=
SEMIBRAIN_SERVICE_TOKEN=
SEMIBRAIN_PEER_CONVERSATION_TOKEN=
SEMIBRAIN_PEER_AGENT_TOKEN=
SEMIBRAIN_PEER_BUSINESS_TOKEN=
SEMIBRAIN_CONVERSATION_URL=http://conversation:8000
SEMIBRAIN_AGENT_URL=http://agent:8000
SEMIBRAIN_BUSINESS_URL=http://business:8000
# Conversation service only. Exact allowed browser origin; HTTPS uses Secure cookies.
SEMIBRAIN_PUBLIC_ORIGIN=http://127.0.0.1:18809
SEMIBRAIN_AUTH_HMAC_KEY=
# Business service only. Scope credentials to its database, bucket and collection.
SEMIBRAIN_MINIO_ENDPOINT=minio:9000
SEMIBRAIN_MINIO_ACCESS_KEY=
SEMIBRAIN_MINIO_SECRET_KEY=
SEMIBRAIN_MINIO_BUCKET=knowledge-assets
SEMIBRAIN_MILVUS_URI=http://milvus:19530
SEMIBRAIN_MILVUS_TOKEN=
SEMIBRAIN_INTERNAL_TOKEN=
# Private foundation probe. Supply a SELECT-only database role to the running business API.
SEMIBRAIN_WAREHOUSE_READ_URL=
SEMIBRAIN_FOUNDATION_TOKEN=
# Offline initialization/acceptance only; never inject owner credentials into an online service.
SEMIBRAIN_WAREHOUSE_ADMIN_URL=
SEMIBRAIN_CHECKPOINT_PROBE_URI=

# Agent service: OpenAI-compatible provider. Set your authorized provider URL.
SEMIBRAIN_LLM_BASE_URL=
SEMIBRAIN_LLM_API_KEY=
SEMIBRAIN_LLM_API_MODE=responses
SEMIBRAIN_LLM_DEFAULT_MODEL=deepseek-flash
SEMIBRAIN_LLM_UNDERSTANDING_MODEL=deepseek-flash
SEMIBRAIN_LLM_INVESTIGATOR_MODEL=deepseek-flash
SEMIBRAIN_LLM_RCA_MODEL=deepseek-flash
SEMIBRAIN_LLM_REVIEWER_MODEL=deepseek-flash
# DeepSeek Responses supports native tools; non-thinking mode avoids plain reasoning replay.
SEMIBRAIN_LLM_REASONING_EFFORT=none
SEMIBRAIN_LLM_ENCRYPTED_REASONING=false
SEMIBRAIN_LLM_STORE=false

# Business service: separately configurable provider credentials and endpoints.
SEMIBRAIN_EMBEDDING_BASE_URL=
SEMIBRAIN_EMBEDDING_API_KEY=
SEMIBRAIN_EMBEDDING_MODEL=qwen3.7-text-embedding
SEMIBRAIN_EMBEDDING_DIMENSIONS=1024
SEMIBRAIN_RERANK_BASE_URL=
SEMIBRAIN_RERANK_API_KEY=
SEMIBRAIN_RERANK_MODEL=qwen3.7-text-rerank
SEMIBRAIN_VISION_BASE_URL=
SEMIBRAIN_VISION_API_KEY=
SEMIBRAIN_VISION_MODEL=qwen3.8-max

# D: optional admission switch. Accepted runs retain their selected graph.
SEMIBRAIN_MULTI_AGENT_ENABLED=false
MULTI_AGENT_ENABLED=false
# Optional complete JSON limits object for controlled single/multi comparisons.
# Omit to retain strategy defaults. User messages cannot override this value.
# Single/multi-agent defaults have no cumulative token cap (tokens=null, final_token_reserve=0).
# Quick web uses its own policy; existing run snapshots keep their original limits.
# Model/tool counts, time limits, per-request output and context limits still apply.
# New runs freeze this policy. Older runs without a snapshot use their old context path.
SEMIBRAIN_CONTEXT_COMPACTION_ENABLED=true
# Optional operator-only overrides: {"default": {...}, "models": {"exact-model": {...}}}
# Defaults: threshold_ratio=.8, retain_ratio=.16, headroom_tokens=65536, summary_tokens=8192.
SEMIBRAIN_COMPACTION_POLICY_JSON={}
SEMIBRAIN_INVESTIGATION_LIMITS=
# Business service and separate Docker broker only; never mount Docker in an Agent container.
SEMIBRAIN_SANDBOX_BACKEND=docker
SEMIBRAIN_SANDBOX_SECRET=
SEMIBRAIN_SANDBOX_IMAGE=
SEMIBRAIN_WEB_PROVIDER=bailian
SEMIBRAIN_WEB_BASE_URL=
SEMIBRAIN_WEB_SEARCH_API_KEY=
SEMIBRAIN_WEB_EXTRACT_API_KEY=
SEMIBRAIN_WEB_MODEL=qwen3.8-max
# Uses the Responses endpoint and search credential above; one bounded fallback request per page.
SEMIBRAIN_WEB_EXTRACT_FALLBACK_ENABLED=true
SEMIBRAIN_MINERU_BASE_URL=https://mineru.net/api/v4
SEMIBRAIN_MINERU_API_KEY=

# Telemetry remains disabled until project keys and an export policy are configured.
SEMIBRAIN_LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Explicit provider context capacity; set to 1048576 only for a verified 1M route.
SEMIBRAIN_LLM_CONTEXT_WINDOW_TOKENS=128000
SEMIBRAIN_LLM_CONTEXT_HEADROOM_TOKENS=8192
# Captured per new run; does not change an active run.
SEMIBRAIN_DSH_CONTEXT_ENABLED=true
SEMIBRAIN_DSH_EFFICIENCY_ENABLED=true
# Managed web originals only. Existing documents/artifacts are excluded.
SEMIBRAIN_EVIDENCE_GC_ENABLED=true
SEMIBRAIN_EVIDENCE_GC_DRY_RUN=true
SEMIBRAIN_EVIDENCE_QUOTA_BYTES=5368709120
