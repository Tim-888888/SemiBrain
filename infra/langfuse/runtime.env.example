# Generate independent strong random secrets in a private directory (mode 0600).
NEXTAUTH_URL=http://127.0.0.1:18811
NEXTAUTH_SECRET=
DATABASE_URL=postgresql://langfuse:REPLACE@postgres:5432/langfuse
SALT=
ENCRYPTION_KEY=
TELEMETRY_ENABLED=false
AUTH_DISABLE_SIGNUP=true
AUTH_EMAIL_VERIFICATION_REQUIRED=false
LANGFUSE_IN_APP_AGENT_ENABLED=false
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=
CLICKHOUSE_CLUSTER_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_AUTH=
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=us-east-1
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/
# No media is sent by the current allowlisted SemiBrain exporter.
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=us-east-1
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/
LANGFUSE_S3_BATCH_EXPORT_ENABLED=false
