{
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "conversation_id": {
      "format": "uuid",
      "title": "Conversation Id",
      "type": "string"
    },
    "turn_id": {
      "format": "uuid",
      "title": "Turn Id",
      "type": "string"
    },
    "input_revision": {
      "minimum": 1,
      "title": "Input Revision",
      "type": "integer"
    },
    "question": {
      "maxLength": 32000,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "mode": {
      "enum": [
        "quick_qa",
        "investigation"
      ],
      "title": "Mode",
      "type": "string"
    },
    "allow_web": {
      "default": false,
      "title": "Allow Web",
      "type": "boolean"
    },
    "resource_restrictions": {
      "items": {
        "type": "string"
      },
      "title": "Resource Restrictions",
      "type": "array"
    },
    "attachment_refs": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Attachment Refs",
      "type": "array"
    }
  },
  "required": [
    "conversation_id",
    "turn_id",
    "input_revision",
    "question",
    "mode"
  ],
  "title": "InputSnapshot",
  "type": "object"
}
