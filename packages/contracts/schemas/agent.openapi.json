  "components": {
    "schemas": {
      "Control": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id"
        ],
        "title": "Control"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InputSnapshot": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "default": "1.0"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Conversation Id"
          },
          "turn_id": {
            "type": "string",
            "format": "uuid",
            "title": "Turn Id"
          },
          "input_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Input Revision"
          },
          "question": {
            "type": "string",
            "maxLength": 32000,
            "minLength": 1,
            "title": "Question"
          },
          "mode": {
            "type": "string",
            "enum": [
              "quick_qa",
              "investigation"
            ],
            "title": "Mode"
          },
          "allow_web": {
            "type": "boolean",
            "title": "Allow Web",
            "default": false
          },
          "investigation_strategy": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "single_agent",
                  "multi_agent"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Investigation Strategy"
          },
          "resource_restrictions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Resource Restrictions"
          },
          "attachment_refs": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Attachment Refs"
          }
        },
        "type": "object",
        "required": [
          "conversation_id",
          "turn_id",
          "input_revision",
          "question",
          "mode"
        ],
        "title": "InputSnapshot"
      },
      "RunRequest": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "default": "1.0"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "input": {
            "$ref": "#/components/schemas/InputSnapshot"
          },
          "subject_ref": {
            "type": "string",
            "format": "uuid",
            "title": "Subject Ref"
          },
          "scope_ref": {
            "type": "string",
            "title": "Scope Ref"
          },
          "policy_version": {
            "type": "string",
            "title": "Policy Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "run_id",
          "input",
          "subject_ref",
          "scope_ref",
          "policy_version"
        ],
        "title": "RunRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
