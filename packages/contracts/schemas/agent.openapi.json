  "components": {
    "schemas": {
      "Control": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id"
        ],
        "title": "Control"
      },
      "DrainEdit": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "draining": {
            "type": "boolean",
            "title": "Draining"
          },
          "actor_id": {
            "type": "string",
            "format": "uuid",
            "title": "Actor Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "expected_revision",
          "draining",
          "actor_id"
        ],
        "title": "DrainEdit"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InputSnapshot": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "default": "1.0"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Conversation Id"
          },
          "turn_id": {
            "type": "string",
            "format": "uuid",
            "title": "Turn Id"
          },
          "input_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Input Revision"
          },
          "question": {
            "type": "string",
            "maxLength": 32000,
            "minLength": 1,
            "title": "Question"
          },
          "mode": {
            "type": "string",
            "enum": [
              "quick_qa",
              "investigation"
            ],
            "title": "Mode"
          },
          "allow_web": {
            "type": "boolean",
            "title": "Allow Web",
            "default": false
          },
          "investigation_strategy": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "single_agent",
                  "multi_agent"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Investigation Strategy"
          },
          "resource_restrictions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Resource Restrictions"
          },
          "attachment_refs": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Attachment Refs"
          }
        },
        "type": "object",
        "required": [
          "conversation_id",
          "turn_id",
          "input_revision",
          "question",
          "mode"
        ],
        "title": "InputSnapshot"
      },
      "MemoryConfigure": {
        "properties": {
          "owner_id": {
            "type": "string",
            "format": "uuid",
            "title": "Owner Id"
          },
          "auth_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Auth Version"
          },
          "change": {
            "$ref": "#/components/schemas/MemorySetting"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "owner_id",
          "auth_version",
          "change"
        ],
        "title": "MemoryConfigure"
      },
      "MemoryDelete": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "expected_revision"
        ],
        "title": "MemoryDelete"
      },
      "MemoryEdit": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "memory_id": {
            "type": "string",
            "format": "uuid",
            "title": "Memory Id"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "kind": {
            "type": "string",
            "enum": [
              "preference",
              "background",
              "investigation_summary"
            ],
            "title": "Kind"
          },
          "content": {
            "type": "string",
            "maxLength": 1600,
            "minLength": 1,
            "title": "Content"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed",
            "default": false
          },
          "source_run_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Run Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "memory_id",
          "expected_revision",
          "kind",
          "content",
          "expires_at"
        ],
        "title": "MemoryEdit"
      },
      "MemoryIdentity": {
        "properties": {
          "owner_id": {
            "type": "string",
            "format": "uuid",
            "title": "Owner Id"
          },
          "auth_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Auth Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "owner_id",
          "auth_version"
        ],
        "title": "MemoryIdentity"
      },
      "MemoryRemove": {
        "properties": {
          "owner_id": {
            "type": "string",
            "format": "uuid",
            "title": "Owner Id"
          },
          "auth_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Auth Version"
          },
          "change": {
            "$ref": "#/components/schemas/MemoryDelete"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "owner_id",
          "auth_version",
          "change"
        ],
        "title": "MemoryRemove"
      },
      "MemorySetting": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "expected_revision",
          "enabled"
        ],
        "title": "MemorySetting"
      },
      "MemoryWrite": {
        "properties": {
          "owner_id": {
            "type": "string",
            "format": "uuid",
            "title": "Owner Id"
          },
          "auth_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Auth Version"
          },
          "edit": {
            "$ref": "#/components/schemas/MemoryEdit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "owner_id",
          "auth_version",
          "edit"
        ],
        "title": "MemoryWrite"
      },
      "Recovery": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "actor_id": {
            "type": "string",
            "format": "uuid",
            "title": "Actor Id"
          },
          "reason": {
            "type": "string",
            "maxLength": 300,
            "minLength": 5,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "actor_id",
          "reason"
        ],
        "title": "Recovery"
      },
      "RetentionRequest": {
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "owner_id": {
            "type": "string",
            "maxLength": 128,
            "title": "Owner Id"
          },
          "snapshot_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Id"
          },
          "content_hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Hash"
          },
          "lineage_aliases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 512,
            "title": "Lineage Aliases"
          },
          "purge": {
            "type": "boolean",
