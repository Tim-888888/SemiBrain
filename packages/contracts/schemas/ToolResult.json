{
  "$defs": {
    "AssetRef": {
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "asset_id": {
          "format": "uuid",
          "title": "Asset Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "asset_id",
        "content_hash",
        "media_type",
        "size_bytes"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "ErrorInfo": {
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message",
        "trace_id"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "SourceRef": {
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "title": "Source Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "scope_ref": {
          "title": "Scope Ref",
          "type": "string"
        },
        "kind": {
          "enum": [
            "document",
            "query",
            "web",
            "image",
            "graph"
          ],
          "title": "Kind",
          "type": "string"
        },
        "data_origin": {
          "enum": [
            "synthetic",
            "public",
            "authorized_business"
          ],
          "title": "Data Origin",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "locator": {
          "additionalProperties": true,
          "title": "Locator",
          "type": "object"
        }
      },
      "required": [
        "source_id",
        "source_version",
        "content_hash",
        "scope_ref",
        "kind",
        "data_origin",
        "observed_at"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "logical_call_id": {
      "format": "uuid",
      "title": "Logical Call Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "succeeded",
        "partial",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "data": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "artifact_refs": {
      "items": {
        "$ref": "#/$defs/AssetRef"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "job_id",
    "logical_call_id",
    "status"
  ],
  "title": "ToolResult",
  "type": "object"
}
