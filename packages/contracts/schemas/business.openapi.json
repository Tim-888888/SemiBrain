        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Id"
          },
          "version": {
            "type": "string",
            "format": "uuid",
            "title": "Version"
          },
          "offset": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Offset",
            "default": 0
          },
          "length": {
            "type": "integer",
            "maximum": 8000.0,
            "minimum": 500.0,
            "title": "Length",
            "default": 6000
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document_id",
          "version"
        ],
        "title": "ReadDocumentInput"
      },
