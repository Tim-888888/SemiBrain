        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "expected_revision": {
            "type": "integer",
            "title": "Expected Revision"
          },
          "version": {
            "type": "string",
            "format": "uuid",
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
